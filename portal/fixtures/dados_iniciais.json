    "fields": {
      "titulo": "Currículo - Gabriel",
      "slug": "curriculo-gabriel",
      "conteudo_html": "<section class=\"conteudo\">\n    <h2 class=\"titulo-conteudo\">Currículo - Gabriel Barbosa</h2>\n\n    <article class=\"caixa caixa-escura\">\n        <img class=\"imagem-perfil\" src=\"/static/portal/img/gabriel-perfil.jpeg\" alt=\"Foto de Gabriel Barbosa da Silva\">\n        <h3>GABRIEL BARBOSA DA SILVA</h3>\n        <p>+55 (11) 97481-7785 | Turma: 513</p>\n\n        <h3 class=\"subtitulo\">Conhecimentos e Habilidades</h3>\n        <ul>\n            <li>Conhecimentos intermediários sobre Python, HTML, CSS, JavaScript e C#.</li>\n            <li>Comunicação, trabalho em equipe, organização, proatividade e adaptabilidade.</li>\n        </ul>\n\n        <h3 class=\"subtitulo\">Objetivos e Interesses</h3>\n        <ul>\n            <li>Seguir na área da programação, principalmente em desenvolvimento web e jogos.</li>\n        </ul>\n    </article>\n</section>\n",
      "ativo": true
    }
  },
  {
    "model": "portal.conteudo",

    "fields": {
      "titulo": "Início",
      "slug": "inicio",
      "conteudo_html": "<section class=\"conteudo\">\n    <h2 class=\"titulo-conteudo\">Bem-vindos ao Nosso Portal</h2>\n\n    <!-- Caixa com as informações da atividade. -->\n    <article class=\"caixa caixa-clara capa-inicio\">\n        <h3>ATV09 - Migração do Portal para Django</h3>\n        <p>\n            Este portal unifica os projetos de <strong>Gabriel Barbosa</strong> e\n            <strong>Eduardo Joaquim</strong>. Ele começou como um site feito só com HTML, CSS e JavaScript\n            e agora foi migrado para o <strong>Django</strong>.\n        </p>\n        <p>\n            Na ATV09, o menu e os conteúdos deixaram de ficar escritos direto nos arquivos HTML:\n            eles ficam guardados no <strong>banco de dados</strong> e são cadastrados pelo\n            <strong>Django Admin</strong>. A navegação usa as URLs e as Views do Django.\n        </p>\n\n        <!-- Área que reúne os dois integrantes. -->\n        <section class=\"dupla-capa\">\n            <article class=\"cartao-capa\">\n                <img class=\"foto-capa\" src=\"/static/portal/img/gabriel-perfil.jpeg\" alt=\"Foto de Gabriel Barbosa da Silva\">\n                <h4>Gabriel Barbosa</h4>\n                <p>Currículo pessoal e tema livre sobre God of War 2.</p>\n            </article>\n\n            <article class=\"cartao-capa\">\n                <img class=\"foto-capa\" src=\"/static/portal/img/eduardo-perfil.png\" alt=\"Foto de Eduardo Joaquim Santos da Silva\">\n                <h4>Eduardo Joaquim</h4>\n                <p>Currículo pessoal e tema livre sobre Dr. Stone.</p>\n            </article>\n        </section>\n\n        <p class=\"frase-capa\">Use o menu para acessar os currículos, os temas escolhidos e a Ouvidoria.</p>\n    </article>\n</section>\n",
      "ativo": true
    }
  },
  {
    "model": "portal.conteudo",
